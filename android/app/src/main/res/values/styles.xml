<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Both themes are dark, in both of the OS's modes. The app has one
         appearance and a launch window that flashes white before it is not a
         theme, it is a bug. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/field_background</item>
    </style>
</resources>
